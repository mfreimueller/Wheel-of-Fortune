{
  "name": "wheel-of-fortune",
  "version": "0.1.0",
  "description": "Student picker wheel for teachers, companion tool to Grader.",
  "license": "MIT",
  "author": "Michael Freimüller <michael@mfreimueller.com> (https://mfreimueller.com)",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && vue-tsc -p tsconfig.web.json --noEmit",
    "package": "npm run build && electron-builder build --mac",
    "package:dir": "npm run build && electron-builder build --mac --dir",
    "icon": "node scripts/make-icon.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-tsc": "^3.3.12"
  },
  "dependencies": {
    "papaparse": "^5.7.0",
    "zod": "^4.6.5"
  }
}
